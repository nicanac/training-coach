# garmin-api (https://garmin-api.nicode.eu) is the only data source: a worker there pulls Garmin Connect
# 4x/day into Postgres and this app reads that cache. Server-side only: never prefix with NEXT_PUBLIC_.

# Read-only token (mint with `scripts/ops.sh token create <label>` in the garmin-api repo).
# Stored in Doppler: project `nicode`, config `prd`, key TRAINING_COACH_GARMIN_API_TOKEN.
# Locally: `npm run dev:doppler` injects it (no file needed). On Vercel: add it as GARMIN_API_TOKEN.
GARMIN_API_TOKEN=

# Optional, this is the default
GARMIN_API_URL=https://garmin-api.nicode.eu
